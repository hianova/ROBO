; ROBO v3.0.0 — Z3 Discrete Tube-CBF Verification, Slack-QP & Contact-Force Falsification
(set-logic ALL)

(declare-const h_k Int)
(declare-const dh_k Int)
(declare-const u_cmd Int)
(declare-const dist Int)
(declare-const d_max Int)

; CHECK 1: Anti-vacuity (expect SAT)
(echo "=== CHECK 1: ANTI-VACUITY (expect SAT) ===")
(push)
(assert (> h_k 0))
(assert (>= d_max 0))
(assert (and (>= dist (- d_max)) (<= dist d_max)))
(assert (>= (+ (+ h_k dh_k) u_cmd) (+ (- h_k (div h_k 4)) d_max)))
(check-sat)
(pop)

; CHECK 2: Discrete ECBF Forward Invariance under modeled disturbance |dist| <= d_max (expect UNSAT)
(echo "=== CHECK 2: DISCRETE ECBF INVARIANCE UNDER |dist| <= d_max (expect UNSAT) ===")
(push)
(assert (>= h_k 0))
(assert (>= d_max 0))
(assert (and (>= dist (- d_max)) (<= dist d_max)))
(assert (>= (+ (+ h_k dh_k) u_cmd) (+ (- h_k (div h_k 4)) d_max)))
(assert (< (+ (+ (+ h_k dh_k) u_cmd) dist) 0))
(check-sat)
(pop)

; CHECK 3: Honest Theory Falsification — unmodeled obstacle shock |dist| > d_max breaks safety (expect SAT)
(echo "=== CHECK 3: THEORY FALSIFICATION - UNMODELED SHOCK > d_max BREACHES SAFETY (expect SAT) ===")
(push)
(assert (= h_k 65536))
(assert (= dh_k 0))
(assert (= d_max 32768))
(assert (>= (+ (+ h_k dh_k) u_cmd) (+ (- h_k (div h_k 4)) d_max)))
(assert (< (+ (+ (+ h_k dh_k) u_cmd) dist) 0))
(check-sat)
(get-value (h_k d_max u_cmd dist))
(pop)

; CHECK 4: Active-Set Halfspace Separation (expect UNSAT)
(echo "=== CHECK 4: ACTIVE-SET HALFSPACE SEPARATION (expect UNSAT) ===")
(push)
(declare-const ax Int) (declare-const ay Int) (declare-const b Int)
(declare-const ux Int) (declare-const uy Int)
(assert (>= (+ (* ax ux) (* ay uy)) b))
(assert (< (+ (* ax ux) (* ay uy)) b))
(check-sat)
(pop)

; CHECK 5: VLA Latency Tube-CBF Inductive Invariance under 30-50 ms delay (expect UNSAT)
(echo "=== CHECK 5: TUBE-CBF INDUCTIVE INVARIANCE UNDER DELAY TUBE (expect UNSAT) ===")
(push)
(declare-const pad Int)
(declare-const decay Int)
(assert (>= pad 0))
(assert (>= d_max 0))
(assert (>= h_k pad))
(assert (and (>= decay 0) (<= decay (- h_k pad))))
(assert (>= dist (- d_max)))
(assert (>= (+ (+ h_k dh_k) u_cmd) (+ (- h_k decay) d_max)))
(assert (< (+ (+ (+ h_k dh_k) u_cmd) dist) pad))
(check-sat)
(pop)

; CHECK 6: Honest Delay Falsification — unmodeled delay > modeled tau breaches barrier (expect SAT)
(echo "=== CHECK 6: DELAY FALSIFICATION - UNMODELED DELAY BREACHES BARRIER (expect SAT) ===")
(push)
(declare-const v_app Int)
(declare-const tau_modeled Int)
(declare-const tau_actual Int)
(assert (= h_k 4000))
(assert (= v_app 100))
(assert (= tau_modeled 30))
(assert (> tau_actual tau_modeled))
(assert (>= (- h_k (* v_app tau_modeled)) 0))
(assert (< (- h_k (* v_app tau_actual)) 0))
(check-sat)
(pop)

; CHECK 7: Slack-QP Guaranteed Feasibility (expect UNSAT)
(echo "=== CHECK 7: SLACK-QP GUARANTEED FEASIBILITY (expect UNSAT) ===")
(push)
(declare-const dot Int)
(declare-const b_con Int)
(declare-const delta Int)
(assert (= delta (ite (> (- b_con dot) 0) (- b_con dot) 0)))
(assert (or (< delta 0) (< (+ dot delta) b_con)))
(check-sat)
(pop)

; CHECK 8: Contact-Force & Joint-Box Invariant (expect UNSAT)
(echo "=== CHECK 8: CONTACT FORCE & JOINT BOX INVARIANT (expect UNSAT) ===")
(push)
(declare-const k_env Int)
(declare-const pen Int)
(declare-const b_env Int)
(declare-const v_up Int)
(declare-const f_max Int)
(assert (> k_env 0))
(assert (>= pen 0))
(assert (>= b_env 0))
(assert (>= v_up 0))
(assert (<= (* k_env pen) f_max))
(assert (> (- (* k_env pen) (* b_env v_up)) f_max))
(check-sat)
(pop)
