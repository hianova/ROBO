; ROBO v2.0.0 — Fast Z3 Discrete ECBF Verification & Model-Violation Falsification
(set-logic ALL)

(declare-const h_k Int)
(declare-const dh_k Int)
(declare-const u_cmd Int)
(declare-const dist Int)
(declare-const d_max Int)

; CHECK 1: Anti-vacuity (expect SAT)
(echo "=== CHECK 1: ANTI-VACUITY (expect SAT) ===")
(push)
(assert (> h_k 0))
(assert (>= d_max 0))
(assert (and (>= dist (- d_max)) (<= dist d_max)))
(assert (>= (+ (+ h_k dh_k) u_cmd) (+ (- h_k (div h_k 4)) d_max)))
(check-sat)
(pop)

; CHECK 2: Discrete ECBF Forward Invariance under modeled disturbance |dist| <= d_max (expect UNSAT)
(echo "=== CHECK 2: DISCRETE ECBF INVARIANCE UNDER |dist| <= d_max (expect UNSAT) ===")
(push)
(assert (>= h_k 0))
(assert (>= d_max 0))
(assert (and (>= dist (- d_max)) (<= dist d_max)))
(assert (>= (+ (+ h_k dh_k) u_cmd) (+ (- h_k (div h_k 4)) d_max)))
(assert (< (+ (+ (+ h_k dh_k) u_cmd) dist) 0))
(check-sat)
(pop)

; CHECK 3: Honest Theory Falsification — unmodeled obstacle shock |dist| > d_max breaks safety (expect SAT)
(echo "=== CHECK 3: THEORY FALSIFICATION - UNMODELED SHOCK > d_max BREACHES SAFETY (expect SAT) ===")
(push)
(assert (= h_k 65536))
(assert (= dh_k 0))
(assert (= d_max 32768))
(assert (>= (+ (+ h_k dh_k) u_cmd) (+ (- h_k (div h_k 4)) d_max)))
(assert (< (+ (+ (+ h_k dh_k) u_cmd) dist) 0))
(check-sat)
(get-value (h_k d_max u_cmd dist))
(pop)

; CHECK 4: Active-Set Halfspace Separation (expect UNSAT)
(echo "=== CHECK 4: ACTIVE-SET HALFSPACE SEPARATION (expect UNSAT) ===")
(push)
(declare-const ax Int) (declare-const ay Int) (declare-const b Int)
(declare-const ux Int) (declare-const uy Int)
(assert (>= (+ (* ax ux) (* ay uy)) b))
(assert (< (+ (* ax ux) (* ay uy)) b))
(check-sat)
(pop)
